{
  "title": "FastAPI - SQLAlchemy Database",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "DB Query Rate",
      "targets": [
        { "expr": "sum(rate(db_client_operation_duration_seconds_count[1m]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB Query p95 Latency",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(db_client_operation_duration_seconds_bucket[5m])) by (le))" }
      ]
    }
  ]
}